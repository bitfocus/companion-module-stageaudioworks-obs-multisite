{
	"name": "stageaudioworks-obs-multisite",
	"version": "0.3.1",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"format:check": "prettier --check .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"dev": "tsc -p tsconfig.build.json --watch",
		"check": "run build && companion-module-check",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest --run"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-stageaudioworks-obs-multisite.git"
	},
	"bugs": "https://github.com/bitfocus/companion-module-stageaudioworks-obs-multisite/issues",
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"obs-websocket-js": "5.0.8"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^22.19.17",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^10.9.1",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.1.11"
	},
	"dependenciesMeta": {
		"esbuild": {
			"built": true
		}
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.0"
}
